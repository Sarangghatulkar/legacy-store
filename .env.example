# ==============================================================================
# ApexStore Environment Configuration (.env.example)
# Duplicate this file as .env.local and populate with your live credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key safe for client-side queries (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Privileged service role secret key (NEVER expose to client - server-only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. Razorpay Merchant Gateway Credentials
# ------------------------------------------------------------------------------
# Merchant Key ID (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_or_test_your_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_your_key_id

# Merchant Key Secret (NEVER expose to client - server-only)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret configured in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. Application Security & Origin
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-strong-32-byte-secret-using-openssl-rand-hex-32
